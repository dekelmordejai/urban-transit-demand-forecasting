{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "stations"
  ],
  "properties": {
    "version": {
      "type": "string",
      "minLength": 1
    },
    "stations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "line_id",
          "station_id",
          "name",
          "valid_from",
          "valid_to"
        ],
        "properties": {
          "line_id": {
            "type": "string",
            "minLength": 1
          },
          "station_id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "valid_from": {
            "type": "string",
            "format": "date-time"
          },
          "valid_to": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
